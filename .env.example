# FitMe — copy to .env and fill in values

# Gemini API (required for default try-on)
GEMINI_API_KEY=

# Optional: override image model (default: gemini-3-pro-image-preview)
# FITME_GEMINI_MODEL=gemini-3-pro-image-preview

# Vertex AI Virtual Try-On (optional)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=configs/service-account.json
